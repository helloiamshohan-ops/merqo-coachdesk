# Development-only configuration. Never use these defaults for a customer deployment.
NODE_ENV=development
COACHDESK_PORT=4310
COACHDESK_DATA_DIR=./var/development
COACHDESK_DEV_PASSWORD=change-this-local-development-password
# A base64 or PEM Ed25519 public key may be configured for license verification.
# COACHDESK_LICENSE_PUBLIC_KEY=...
